# Configuration Gmail pour l'envoi d'emails
GMAIL_USER=votre-email@gmail.com
GMAIL_PASS=votre-mot-de-passe-application-gmail

# Configuration des emails (optionnel)
GMAIL_FROM_NAME=Alexandre Graff
GMAIL_ADMIN_EMAIL=admin@example.com

# Configuration Redis pour rate limiting (optionnel - utilise la mémoire si non configuré)
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# Configuration du site (pour CORS et URLs)
NEXT_PUBLIC_SITE_URL=https://votre-domaine.com

# Instructions Gmail:
# 1. Activez l'authentification à 2 facteurs sur votre compte Google
# 2. Allez dans "Paramètres du compte Google" > "Sécurité" > "Mots de passe des applications"
# 3. Générez un mot de passe d'application pour "Mail"
# 4. Utilisez ce mot de passe (16 caractères) dans GMAIL_PASS

# Instructions Redis (optionnel pour le rate limiting):
# 1. Créez un compte sur https://upstash.com
# 2. Créez une base Redis
# 3. Copiez l'URL REST et le token
# Si non configuré, le système utilisera un cache mémoire local